SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DATABASE_URL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DataForge <no-reply@example.com>
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_SECONDS=60

# Optional Gemini-only AI features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATAFORGE_AI_DAILY_LIMIT=10
DATAFORGE_AI_GLOBAL_DAILY_LIMIT=100
DATAFORGE_AI_MAX_INPUT_CHARS=4000
DATAFORGE_AI_MAX_OUTPUT_TOKENS=800
DATAFORGE_AI_TIMEOUT_MS=30000
